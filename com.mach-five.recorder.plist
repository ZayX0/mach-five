<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mach-five.recorder</string>

  <!-- caffeinate -i wraps the recorder so keep-awake lives and dies with it -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/path/to/python3</string>
    <string>recorder.py</string>
    <string>run</string>
  </array>

  <!-- edit the three /path/to/... entries to your layout (launchd needs
       absolute paths). .env (ODDS_API_KEY) and recordings/ resolve here -->
  <key>WorkingDirectory</key>
  <string>/path/to/mach-five</string>

  <key>StandardOutPath</key>
  <string>/path/to/mach-five/recorder.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/mach-five/recorder.log</string>

  <key>RunAtLoad</key>
  <true/>
  <!-- restart on any exit; recorder resume logic makes this safe -->
  <key>KeepAlive</key>
  <true/>
  <!-- don't restart-loop faster than this if it crashes at startup -->
  <key>ThrottleInterval</key>
  <integer>15</integer>
</dict>
</plist>
