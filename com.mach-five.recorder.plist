<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mach-five.recorder</string>

  <!-- caffeinate -i wraps the recorder so keep-awake lives and dies with it -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/Users/isaiahreed/.pyenv/versions/3.12.3/bin/python3</string>
    <string>recorder.py</string>
    <string>run</string>
  </array>

  <!-- .env (ODDS_API_KEY) and recordings/ are resolved relative to here -->
  <key>WorkingDirectory</key>
  <string>/Users/isaiahreed/Projects/mach-five</string>

  <key>StandardOutPath</key>
  <string>/Users/isaiahreed/Projects/mach-five/recorder.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/isaiahreed/Projects/mach-five/recorder.log</string>

  <key>RunAtLoad</key>
  <true/>
  <!-- restart on any exit; recorder resume logic makes this safe -->
  <key>KeepAlive</key>
  <true/>
  <!-- don't restart-loop faster than this if it crashes at startup -->
  <key>ThrottleInterval</key>
  <integer>15</integer>
</dict>
</plist>
