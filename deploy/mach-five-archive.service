# One-shot: gzip-move closed recording days from local disk to the NFS
# mount. Edit User= and the /opt/mach-five paths to your layout.
# Paired with mach-five-archive.timer; also safe to run by hand:
#   sudo systemctl start mach-five-archive
[Unit]
Description=mach-five recordings archiver (local disk -> NFS)
# Don't run unless the NFS mount is actually there — a missing mount must
# fail the unit, not archive into an empty mountpoint directory.
RequiresMountsFor=/mach-five

[Service]
Type=oneshot
User=mach-five
WorkingDirectory=/opt/mach-five
ExecStart=/opt/mach-five/.venv/bin/python3 archive_recordings.py recordings /mach-five/recordings
